#!/usr/bin/env bash
# Keep README.md section counts in sync with the actual number of entries,
# and the translated READMEs in step with README.md.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Skip for one commit with:  git commit --no-verify
set -euo pipefail

# Only run when a README is part of this commit.
if ! git diff --cached --name-only | grep -qE '^README(\.[A-Za-z-]+)?\.md$'; then
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 not found, skipping count sync" >&2
    exit 0
fi

before="$(git hash-object "$repo_root/README.md")"
python3 "$repo_root/scripts/sync_counts.py"
after="$(git hash-object "$repo_root/README.md")"

if [ "$before" != "$after" ]; then
    git add "$repo_root/README.md"
    echo "pre-commit: README.md counts were stale and have been synced and re-staged."
fi

# Truncated glosses cannot be repaired automatically, so this one only reports.
if ! python3 "$repo_root/scripts/check_glosses.py"; then
    echo "pre-commit: rewrite the gloss above from the paper's own abstract, then commit again." >&2
    exit 1
fi

# Counts carry over to the translations on their own; a new or changed entry
# has to be translated by hand.
translations=("$repo_root"/README.*.md)
sums_before="$(cat "${translations[@]}" | git hash-object --stdin)"
if ! python3 "$repo_root/scripts/check_i18n.py" --fix; then
    echo "pre-commit: bring README.ko.md, README.zh-CN.md and README.ja.md in line with README.md, then commit again." >&2
    exit 1
fi
if [ "$sums_before" != "$(cat "${translations[@]}" | git hash-object --stdin)" ]; then
    git add "${translations[@]}"
    echo "pre-commit: translated counts were stale and have been synced and re-staged."
fi
